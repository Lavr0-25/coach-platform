# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# dogfood-тесты: отчёты и HTML-доказательства, не для репо
/dogfood-output/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# скриншоты багов: рабочая очередь, не для репо (кроме .gitkeep)
/scrin_bag/*
!/scrin_bag/.gitkeep

# артефакты Playwright MCP (скриншоты, снапшоты, логи) — рабочие файлы агента, не для репо
/.playwright-mcp/

# временные/тестовые файлы агента (макеты, черновики) — правило: всё временное живёт в tmp/
/tmp/

# ИИ-агент (agent/): секретный ключ автора + логи запусков — в git не попадают
/agent/config.json
/agent/logs/
/agent/tmp/
